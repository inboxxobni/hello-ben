{
  "name": "hello-ben",
  "version": "0.1.1",
  "description": "The hello-ben Cordis plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inboxxobni/hello-ben.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  },
  "keywords": [
    "cordis",
